#!/usr/bin/env python3

import json
import subprocess
import sys

TERRAFORM_DIR = "../"  # sobe para raiz do projeto


def get_output(output_name):
    try:
        result = subprocess.run(
            ["terraform", "output", "-json", output_name],
            cwd=TERRAFORM_DIR,
            capture_output=True,
            text=True,
            check=True
        )
        return json.loads(result.stdout)
    except subprocess.CalledProcessError:
        return {}


def generate_inventory():
    web_vms = get_output("vms_web_public_ips")
    db_vms = get_output("vms_db_public_ips")

    inventory = {
        "vms_web": {"hosts": []},
        "vms_db": {"hosts": []},
        "_meta": {"hostvars": {}}
    }

    # WEB GROUP
    for hostname, ip in web_vms.items():
        inventory["vms_web"]["hosts"].append(hostname)
        inventory["_meta"]["hostvars"][hostname] = {
            "ansible_host": ip,
#            "ansible_user": "azureuser",
#            "ansible_ssh_private_key_file": "~/.ssh/id_rsa"
        }

    # DB GROUP
    for hostname, ip in db_vms.items():
        inventory["vms_db"]["hosts"].append(hostname)
        inventory["_meta"]["hostvars"][hostname] = {
            "ansible_host": ip,
#            "ansible_user": "azureuser",
#            "ansible_ssh_private_key_file": "~/.ssh/id_rsa"
        }

    return inventory


if __name__ == "__main__":
    if len(sys.argv) == 2 and sys.argv[1] == "--list":
        print(json.dumps(generate_inventory(), indent=2))
    else:
        print(json.dumps({}))

